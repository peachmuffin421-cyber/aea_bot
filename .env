# ============================================================================
# ÆEA TELEGRAM BOT — ENVIRONMENT TEMPLATE
# Version: vFinal + ALLOWED_IDS Heroku Patch
# Blank ALLOWED_IDS = open bot to all
# ============================================================================
# Copy to `.env` for local runs:
#   cp .env.example .env
#   $EDITOR .env
#   set -a; . ./.env; set +a
#   python3 app.py
#
# Heroku: .env is ignored, set vars via:
#   heroku config:set KEY=value -a your-app-name
# ============================================================================

# REQUIRED — TELEGRAM
# Bot token from @BotFather. Also used to derive WebApp initData HMAC.
TELEGRAM_BOT_TOKEN=

# BOT ACCESS CONTROL — HEROKU VAR (YOUR REQUEST)
# ALLOWED_IDS controls who can use the bot.
#   Blank / unset = OPEN BOT TO ALL (public)
#   Set = private to those IDs only
#
# Format: comma, space, or semicolon separated integers
#   Single:   ALLOWED_IDS=8769538718
#   Multiple: ALLOWED_IDS=8769538718,123456789,987654321
#   Open:     ALLOWED_IDS=  (blank)  OR heroku config:unset ALLOWED_IDS
#
# Heroku:
#   heroku config:set ALLOWED_IDS="8769538718" -a your-app-name
#   heroku config:set ALLOWED_IDS="" -a your-app-name
#   heroku config:unset ALLOWED_IDS -a your-app-name
ALLOWED_IDS=

# Legacy fallback name (still read if ALLOWED_IDS is blank)
# ALLOWED_USER_IDS=

# REQUIRED FOR MINI APP — PUBLIC HTTPS ENDPOINT
# GitHub Pages URL of the Mini App. Must be HTTPS.
# Local tunnel mode: leave empty (auto-spawns *.trycloudflare.com)
# Split-origin: https://<user>.github.io/<repo>/
TELEGRAM_WEBAPP_URL=

# REQUIRED FOR MARKET DATA — CLOUDFLARE WORKER RELAY
# Public URL of deployed Worker (aei-relay repo)
# Example: https://aei-relay.<your-subdomain>.workers.dev
RELAY_URL=
RELAY_KEY=
RELAY_TIMEOUT=10
RELAY_MAX_RETRIES=3

# BRIDGE — LOCAL HTTP SERVER
# Heroku assigns $PORT dynamically; app.py prefers $PORT over BRIDGE_PORT.
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8765
BRIDGE_USE_TLS=0
BRIDGE_TLS_CERT=
BRIDGE_TLS_KEY=
BRIDGE_TUNNEL=cloudflared
BRIDGE_PUBLIC_TIMEOUT=45

# AUTH & LOGGING
# Enforce X-Telegram-Init-Data on all non-/health endpoints.
# Set to 0 ONLY for local development without Telegram WebView.
REQUIRE_AUTH=1
LOG_BUFFER_SIZE=1000
TOAST_BUFFER_SIZE=500

# CORS
# "*" permits any origin. Lock down in production:
# CORS_ORIGIN=https://<user>.github.io
CORS_ORIGIN=*

# ENGINE — SYMBOL & POLLING
# SYMBOL defaults to BTC-USD if unset.
SYMBOL=BTC-USD
UPDATE_INTERVAL=30
MAX_MIN_GAP=2
MIN_PERIOD_FLOOR=3

# POINT-SIZE TABLE (broker tick size emulation)
# JSON map to override specific entries. Leave empty to use built-in table.
# Example: SYMBOL_DIGITS={"BTC-USD":2,"PEPE-USD":6}
SYMBOL_DIGITS=
SYMBOL_DIGITS_DEFAULT=2

# E-1: TELEGRAM PUSH NOTIFICATION SWITCHES (1=enabled, 0=disabled)
PUSH_ON_SIGNAL=1
PUSH_ON_EXECUTION=1
PUSH_ON_FVG=1
PUSH_ON_CLOSE=1
PUSH_DEDUP_WINDOW_MS=800

# E-3: ARC-LENGTH PROJECTION PARAMETERS
ARC_PROJECTION_HORIZON=30
ARC_PROJECTION_STEP=1
ARC_PROJECTION_DAMPING=0.94
